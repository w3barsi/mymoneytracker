{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-tracker",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "money.darcygraphix.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
